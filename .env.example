# Copy to .env and fill in. Empty values fall back to the defaults in
# gradclassorg/settings.py. Leave EMAIL_HOST empty in dev: reset mails are then
# printed to the terminal instead of being sent. See docs/environment.md for all
# variables.

EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=
EMAIL_USE_SSL=
DEFAULT_FROM_EMAIL=
DEFAULT_REPLY_TO=
